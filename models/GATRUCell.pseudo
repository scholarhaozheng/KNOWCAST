MODULE models.GATRUCell
FORMAT Pseudocode.
PURPOSE Graph attention followed by a recurrent update.
PAPER Section 4.8, Eqs. (31)-(33).
INPUT Node features[V_total,D], directed graph, optional hidden[V_total,h].
OUTPUT Emitted state and carried state, both [V_total,h].
PARAMETERS Attention dimensions, recurrent profile, initialization and state regularization.

PROCEDURE zoneout(prev_h, next_h, rate, training=true)
    INPUT Equal-shaped states and rate in [0,1].
    IF rate=0: RETURN next_h.
    IF rate=1: RETURN prev_h.
    IF training:
        mask <- BERNOULLI(rate,SHAPE(prev_h)).
        RETURN mask*prev_h+(1-mask)*next_h.
    ELSE:
        RETURN rate*prev_h+(1-rate)*next_h.
    END IF.
END PROCEDURE

CLASS KStepRGCN
    PURPOSE K-layer attention stack retained under its compatibility name.
    PARAMETERS attention_layers[K], intermediate activation.
END CLASS

PROCEDURE KStepRGCN.__init__(in_channels, out_channels, num_relations, num_bases, K, bias, options)
    STORE in_channels,out_channels,K.
    attention_layers <- empty registered list.
    H,C,concat <- options.heads,options.head_width,options.concat.
    IF (H*C if concat, otherwise C)!=out_channels: RAISE Error(incompatible_head_width).
    FOR depth=0..K-1:
        width <- in_channels if depth=0, otherwise out_channels.
        layer <- GATConv(in_channels=width,out_channels=C,heads=H,concat=concat,
            negative_slope=options.negative_slope,dropout=options.dropout,
            add_self_loops=options.add_self_loops,edge_dim=options.edge_dim,
            fill_value=options.fill_value,bias=bias).
        APPEND layer to attention_layers.
    END FOR.
    activation <- REGISTER options.intermediate_activation.
    RETURN this stack.
END PROCEDURE

PROCEDURE KStepRGCN.forward(x, edge_index, edge_attr)
    current <- x.
    FOR depth=0..K-1:
        current <- attention_layers[depth].forward(current,edge_index,edge_attr).
        IF depth<K-1: current <- activation(current).
    END FOR.
    RETURN current.
END PROCEDURE

CLASS GATRUCell
    PARAMETERS paper_equations: spatial attention, W_r/W_z/W_candidate and biases.
    PARAMETERS legacy_dual_graph: cheb_i/cheb_h stacks and three bias vectors.
    STATE Parameters are reused across time; hidden state belongs to one sequence.
END CLASS

PROCEDURE GATRUCell.__init__(in_channels, out_channels,
    dropout_type=absent, dropout_prob=0, num_relations=3, num_bases=3,
    K=1, num_nodes=80, global_fusion=false, options=absent)
    D,h <- in_channels,out_channels.
    RESOLVE named options over the explicit compatibility arguments.
    IF global_fusion: RAISE Error(unsupported_global_fusion).
    IF dropout_type is outside {absent,dropout,zoneout} OR dropout_prob<0 OR dropout_prob>1:
        RAISE Error(invalid_state_regularization).
    END IF.
    profile <- options.profile.
    IF profile=paper_equations:
        H,C <- options.gat.heads,options.gat.head_width.
        spatial_attention <- REGISTER GATConv(in_channels=D,out_channels=C,heads=H,concat=true,
            negative_slope=options.gat.negative_slope,dropout=options.gat.dropout,
            add_self_loops=options.gat.add_self_loops,edge_dim=options.gat.edge_dim,
            fill_value=options.gat.fill_value,bias=options.gat.bias).
        spatial_activation <- REGISTER options.spatial_activation.
        F_width <- H*C.
        ALLOCATE W_r[h,h+F_width],W_z[h,h+F_width],W_candidate[h,h+F_width].
        ALLOCATE b_r[h],b_z[h],b_candidate[h].
        REGISTER the recurrent tensors.
    ELSE IF profile=legacy_dual_graph:
        cheb_i <- REGISTER KStepRGCN(D,3h,num_relations,num_bases,K,false,options.gat).
        cheb_h <- REGISTER KStepRGCN(h,3h,num_relations,num_bases,K,false,options.gat).
        ALLOCATE and REGISTER bias_i[h],bias_r[h],bias_n[h].
    ELSE:
        RAISE Error(unknown_recurrent_profile).
    END IF.
    reset_parameters().
    RETURN this cell.
END PROCEDURE

PROCEDURE GATRUCell.reset_parameters()
    IF profile=paper_equations:
        spatial_attention.reset_parameters().
        INITIALIZE recurrent matrices and biases with options.recurrent_initializer.
    ELSE:
        bias_i,bias_r,bias_n <- ones[h],ones[h],ones[h].
    END IF.
    RETURN this initialized parameter state.
END PROCEDURE

PROCEDURE GATRUCell.forward(inputs, edge_index, edge_attr, hidden=absent)
    IF hidden is absent: hidden <- zeros[V_total,h] on inputs.device with inputs.dtype.
    CHECK hidden's shape and node order match inputs.
    IF profile=paper_equations:
        CHECK the physical graph has one directed edge per station-neighbor pair.
        IF NOT options.gat.add_self_loops: CHECK each node has its own self edge.
        F <- spatial_activation(spatial_attention.forward(inputs,edge_index,edge_attr)).
        gate_input <- CONCATENATE(hidden,F,feature_axis).
        r <- SIGMOID(gate_input*TRANSPOSE(W_r)+b_r).
        z <- SIGMOID(gate_input*TRANSPOSE(W_z)+b_z).
        candidate_input <- CONCATENATE(r*hidden,F,feature_axis).
        candidate <- TANH(candidate_input*TRANSPOSE(W_candidate)+b_candidate).
        raw_next <- (1-z)*hidden+z*candidate.
    ELSE:
        i_r,i_i,i_n <- SPLIT(cheb_i.forward(inputs,edge_index,edge_attr),three width-h blocks).
        h_r,h_i,h_n <- SPLIT(cheb_h.forward(hidden,edge_index,edge_attr),three width-h blocks).
        reset_gate <- SIGMOID(i_r+h_r+bias_r).
        retention_gate <- SIGMOID(i_i+h_i+bias_i).
        candidate <- TANH(i_n+reset_gate*h_n+bias_n).
        raw_next <- (1-retention_gate)*candidate+retention_gate*hidden.
    END IF.
    IF dropout_type=zoneout:
        carried <- zoneout(hidden,raw_next,dropout_prob,training_mode).
    ELSE IF dropout_type=dropout AND training_mode:
        IF dropout_prob>=1: RAISE Error(invalid_state_dropout).
        carried <- BERNOULLI(1-dropout_prob,SHAPE(raw_next))*raw_next/(1-dropout_prob).
    ELSE:
        carried <- raw_next.
    END IF.
    RETURN raw_next,carried.
END PROCEDURE

PROCEDURE GATRUCell.verify_gate_and_gradient_contract()
    INPUT A runnable cell implementation and a controlled verification fixture.
    CHECK paper profile z=0 returns hidden and z=1 returns candidate before regularization.
    CHECK reset multiplies hidden before W_candidate.
    CHECK graph messages remain within each sample and active parameters receive gradients.
    CHECK legacy profile uses its separately named retention gate.
    RETURN measured verification results.
END PROCEDURE
END MODULE
